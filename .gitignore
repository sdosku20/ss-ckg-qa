# --- Never commit credentials or clinical data -------------------------------
# The Neo4j password lives in ~/.ikgqa.env on the server, outside the repo.
# These patterns are a second line of defence, not the primary one.
*.env
.env
.env.*
!.env.example
secrets.*
credentials.*

# The gold question set. Its questions name real patients and its answers are
# real node keys, so the file is governed data even though the tooling that
# reads it is not. Keep it on BioMedIT; commit ikgqa.eval.goldset instead, and
# the synthetic fixtures in tests/.
/gold/

# Any extract from the clinical graph. Governed data stays on BioMedIT.
# Leading slash = repo root only. Without it, "data/" also matched
# src/ikgqa/data/, which silently kept the SPHN loader out of version control.
/data/
/extracts/
*.dump
*.csv
*.tsv
*.parquet
*.jsonl
recon*.txt
schema_edges.txt
code_fields.txt

# Exception: the terminology cross-walk is *public reference data* (ICD-10-GM,
# LOINC, ATC labels), not a clinical extract, and it must be committed so
# results are reproducible. Nothing patient-level ever goes in this directory.
!terminology/
!terminology/*.csv

# Exception: results computed on the SYNTHETIC replica. No clinical data can
# reach these files -- the replica never touches the database. They are
# committed because they are the offline record of what was run.
!experiments/results/
!experiments/results/*.csv

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Virtual environments (PCST/.venv is the current one; never commit a venv)
.venv/
venv/
env/

# --- Caches produced by the pipeline ----------------------------------------
# Embedding caches can be regenerated and are large.
/cache/
*.npy
*.npz
!tests/fixtures/*.npy

# --- LaTeX -------------------------------------------------------------------
# Build products of thesis/. The .tex sources and references.bib are the source
# of truth; everything below is regenerated by the Makefile.
*.aux
*.bbl
*.blg
*.lof
*.log
*.lot
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.bak
thesis/Thesis.pdf

# The transfer archive built by the scp recipe in STATUS.md.
ikgqa.tar.gz

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
